# ============================================================
# AgentDyne Platform — Environment Variables
# Last updated: May 2026 | v2.0.0
# ============================================================
#
# LOCAL DEVELOPMENT:
#   cp .env.example .env.local
#   Fill in the values below, then: npm run dev
#
# CLOUDFLARE PAGES PRODUCTION:
#   Go to: Cloudflare Dashboard → Pages → your project
#   → Settings → Environment Variables → Add variable
#   ⚠️  NEXT_PUBLIC_* vars MUST be added as Production variables
#   ⚠️  They are NOT automatically picked up from build secrets
#   ⚠️  After adding, trigger a new deployment (push a commit)
#
# DIAGNOSTIC PAGE (check what's configured):
#   http://localhost:3000/api/debug/config   (local)
#   https://your-site.com/api/debug/config  (staging)
#
# ── COMMON MISTAKE ───────────────────────────────────────────────────────────
# Setting SUPABASE_SERVICE_ROLE_KEY but NOT the NEXT_PUBLIC_ vars
# causes "Supabase not configured" on the login page.
# Login requires the NEXT_PUBLIC_ anon key, not the service role key.
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════
# TIER 1 — REQUIRED FOR LOGIN TO WORK
# ══════════════════════════════════════════════════════════════
# Get all three from: Supabase Dashboard → your project → Settings → API

# Your Supabase project URL (NEXT_PUBLIC = visible in browser — this is safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co

# Your Supabase anon / public key (NEXT_PUBLIC = visible in browser — this is safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Your Supabase service role key (SERVER ONLY — never expose to browser)
# Used for admin operations, background jobs, and server-side DB access.
# In Cloudflare Pages: add WITHOUT the NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ══════════════════════════════════════════════════════════════
# TIER 2 — REQUIRED FOR AI AGENTS TO RUN
# ══════════════════════════════════════════════════════════════
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Your production URL — used in emails, embed scripts, and OG tags
NEXT_PUBLIC_APP_URL=https://agentdyne.com

# ══════════════════════════════════════════════════════════════
# TIER 3 — STRONGLY RECOMMENDED (features degrade without these)
# ══════════════════════════════════════════════════════════════

# OpenAI — enables semantic memory search + GPT agents
# Without this: memory search falls back to keyword-only; no GPT agents
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Google Gemini — enables Gemini 2.5 Flash/Pro agents (cheapest tier)
# Without this: Gemini agents fall back to Claude Haiku
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=AIzaSy...

# ══════════════════════════════════════════════════════════════
# TIER 4 — BILLING (required for paid subscriptions)
# ══════════════════════════════════════════════════════════════
# Get from: https://dashboard.stripe.com/developers/api-keys
# Use sk_test_ and pk_test_ for development

STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Get from: Stripe Dashboard → Developers → Webhooks → endpoint → Signing secret
# Register endpoint URL: https://your-site.com/api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.*, invoice.payment_*
STRIPE_WEBHOOK_SECRET=whsec_...

# Create products in: Stripe Dashboard → Products → Add Product → Recurring
STRIPE_STARTER_PRICE_ID=price_...    # $19/month
STRIPE_PRO_PRICE_ID=price_...        # $79/month

# ══════════════════════════════════════════════════════════════
# TIER 5 — MONITORING (you'll be blind without these)
# ══════════════════════════════════════════════════════════════

# Slack webhook — fires on errors, abuse events, billing failures
# Create: https://api.slack.com/apps → Incoming Webhooks → Add to Workspace
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/xxx

# Better Stack heartbeat — 30s uptime checks (free)
# Create: https://betterstack.com/uptime → New Monitor → Heartbeat
BETTER_STACK_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/xxx

# Sentry DSN — structured error tracking (free 5k errors/month)
# Create: https://sentry.io → New Project → Next.js
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Admin alert email — billing anomalies, large abuse events
ADMIN_ALERT_EMAIL=founder@agentdyne.com

# ══════════════════════════════════════════════════════════════
# TIER 6 — EMAIL (transactional)
# ══════════════════════════════════════════════════════════════
# Supabase handles auth emails by default.
# Use Resend for custom branded templates.
# Get from: https://resend.com/api-keys
# RESEND_API_KEY=re_...

# ══════════════════════════════════════════════════════════════
# OPTIONAL OVERRIDES
# ══════════════════════════════════════════════════════════════
# MAINTENANCE_MODE=false          # Set "true" to show maintenance page
# DISABLE_DEBUG_ENDPOINTS=true    # Disable /api/debug/config in production
# NEXT_PUBLIC_APP_VERSION=2.0.0
